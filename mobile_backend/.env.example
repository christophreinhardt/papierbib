# Keine echten Zugangsdaten committen. Diese Datei nach .env kopieren.
PAPIERBIB_PASSWORD=
# Exakte Adresse OHNE abschließenden Slash oder Pfad.
PUBLIC_ORIGIN=https://homeserver.example.ts.net
# Für Tailscale Serve auf dem Host. Bei bewusstem LAN-Zugriff: 0.0.0.0
HOST_BIND=127.0.0.1
MAX_IMAGE_BYTES=20971520
# Wahl: openai oder gemini. Mindestens der passende Key muss in Portainer gesetzt sein.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
