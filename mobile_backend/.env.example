# Required for all non-health API calls. Generate a long random value.
PAPIERBIB_API_TOKEN=change-this-to-a-long-random-token
# openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
# Comma-separated allowed browser origins. Use the exact Pages URL.
CORS_ORIGINS=https://christophreinhardt.github.io
LOBID_TIMEOUT_SECONDS=12
MAX_IMAGE_BYTES=12000000